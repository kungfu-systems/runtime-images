{
  "schema": "kungfu.course-hub-runtime/v2",
  "status": "development-candidate",
  "authority": {
    "identitySessionsCoursesVersionsApprovals": "PostgreSQL with forced per-account row isolation",
    "inference": "selected AgentWorkPort backend with PostgreSQL-persisted provenance",
    "workControl": "Kungfu public CLI with native Assignment, Episode, review, decision, and seal",
    "web": "non-authoritative command and projection surface"
  },
  "business": {
    "authenticated": true,
    "multiAccountIsolation": true,
    "courseCollection": true,
    "immutableOutlineVersions": true,
    "approvalPointer": true,
    "durableOutbox": true,
    "database": "PostgreSQL 17",
    "applicationRole": "course_app NOBYPASSRLS"
  },
  "inference": {
    "modes": ["mock", "local", "hosted"],
    "silentMockFallback": false,
    "localRuntime": "llama.cpp in the first-party application image",
    "embeddedModelWeights": false,
    "modelInstall": "authenticated explicit click, resumable, exact bytes and SHA-256, atomic rename",
    "minimumPinnedQwenChoices": 3
  },
  "workControl": {
    "stableBinding": "kungfu:course:<course-id>",
    "unit": "one AgentWork lifecycle per generated course version",
    "stages": [
      "Assignment capture and admission",
      "bounded claim and kickoff",
      "immutable artifact Evidence Episode",
      "independent fit review",
      "typed close decision",
      "portable state seal"
    ],
    "recovery": "resume from public native status without reconstructing private records"
  },
  "sourceBuild": {
    "kungfuSourceSha": "83e75ffc8ff3cc05199e257a180eac6a7380949d",
    "qualificationRuns": {
      "linux/amd64": "https://github.com/kungfu-systems/kungfu/actions/runs/30330617397",
      "linux/arm64": "https://github.com/kungfu-systems/kungfu/actions/runs/30330528786"
    },
    "packages": {
      "linux/amd64": {
        "name": "kungfu-episodes-cli-linux-x64.tar.gz",
        "sha256": "c58add4d6530541b1a7e4233573f13502a306614a8bb79e0bd60988b78f061ca"
      },
      "linux/arm64": {
        "name": "kungfu-episodes-cli-linux-arm64.tar.gz",
        "sha256": "36085af2deeb62e35b7e147ad573281f5961877fc35cd2e54ed3ed52d5fbe4ab"
      }
    }
  },
  "runtime": {
    "baseImage": "node:24-trixie-slim@sha256:ae91dcc111a68c9d2d81ff2a17bda61be126426176fde6fe7d08ab13b7f50573",
    "llamaImage": "ghcr.io/ggml-org/llama.cpp:server@sha256:a576442ad3649c0b5ea74e20ad29a17c121117f32607cfe59ff27cc38066f874",
    "platforms": ["linux/amd64", "linux/arm64"],
    "user": "node",
    "readOnlyRoot": true,
    "writablePaths": ["/state", "/models", "/tmp"],
    "localhostDefault": true,
    "privileged": false,
    "hostNetwork": false,
    "dockerSocket": false,
    "capabilityAdditions": []
  },
  "persistence": {
    "volumes": ["PostgreSQL business data", "Kungfu native state", "optional model weights"],
    "destructiveCleanupCommand": null
  },
  "substitutionSeam": {
    "environment": "KUNGFU_HUB_IMAGE",
    "policy": "exact digest only",
    "officialAlpha": "replace only after independent qualification and lock update"
  },
  "nonClaims": [
    "not production ready",
    "not public-ingress ready",
    "not a complete LMS",
    "not billing or account recovery",
    "not highly available",
    "not a native Windows container",
    "not an official Kungfu Alpha or stable release"
  ]
}
