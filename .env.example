# No .env file is required for an ordinary installation. Copy this file only
# when you want to override defaults. Database passwords are generated once and
# retained in the private named configuration volume.

# The default is loopback-only. HUB_PUBLIC_ORIGIN follows HUB_PORT automatically.
# Set HUB_BIND_ADDRESS and HUB_PUBLIC_ORIGIN together only when intentionally
# sharing a disposable preview on a trusted LAN.
HUB_BIND_ADDRESS=127.0.0.1
HUB_PORT=8080
# HUB_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Optional exact-digest override. Floating image tags are intentionally rejected.
KUNGFU_HUB_IMAGE=ghcr.io/kungfu-systems/runtime-images/hub-starter@sha256:d2fb8c300bb61a1dadf605fbfab2b1438c067fd17320e287ff4b1d3f4991ca9b
