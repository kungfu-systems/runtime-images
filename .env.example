# No .env file is required for an ordinary installation. Copy this file only
# when you want to override defaults. Database passwords are generated once and
# retained in the private named configuration volume.

# The supported installation is loopback-only. HUB_PUBLIC_ORIGIN follows
# HUB_PORT automatically.
HUB_PORT=8080
# HUB_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Optional exact-digest override. Floating image tags are intentionally rejected.
KUNGFU_HUB_IMAGE=ghcr.io/kungfu-systems/runtime-images/hub-starter@sha256:5614cf1d9feaf4d085a94cf76389933d3d90b9b628ac7bffb64e3b53a176ee92
