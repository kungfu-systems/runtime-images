# Copy this file to .env for a disposable local development installation.
# Replace these synthetic values before retaining any meaningful local data.
COURSE_DB_MIGRATION_PASSWORD=synthetic_migration_42
COURSE_DB_APP_PASSWORD=synthetic_runtime_42

# The default is loopback-only. Set HUB_BIND_ADDRESS and HUB_PUBLIC_ORIGIN
# together only when intentionally sharing a disposable preview on a trusted LAN.
HUB_BIND_ADDRESS=127.0.0.1
HUB_PORT=8080
HUB_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Optional exact-digest override. Floating image tags are intentionally rejected.
KUNGFU_HUB_IMAGE=ghcr.io/kungfu-systems/runtime-images/hub-starter@sha256:d2fb8c300bb61a1dadf605fbfab2b1438c067fd17320e287ff4b1d3f4991ca9b
